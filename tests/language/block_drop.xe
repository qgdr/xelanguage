// 检查模式：观察嵌套作用域、逆序析构以及块返回值的所有权转移。
struct Trace {
    label: i32,
}

impl Drop for Trace {
    fn drop(self: Self@[mut]) {
        println("drop {}", self.label);
    }
}

fn main() {
    let outer: Trace << Trace { .label = 0; };
    let kept: Trace << {
        let first: Trace << Trace { .label = 1; };
        let second: Trace << Trace { .label = 2; };
        let result: Trace << Trace { .label = 3; };
        result
    }; // 输出 drop 2、drop 1；result 已移出
    println("block finished");
} // 输出 drop 3、drop 0
