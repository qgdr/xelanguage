// 历史文件名保留；现在检查始终开启，修改必须明确标注。
fn advance(index: i32) -> i32 {
    let[mut] index = index;
    index = index + 1;
    index
}

fn main() {
    let[mut] count: i32 = advance(1);
    count = count + 1;
    let pointer: i32@[mut] = count@[mut];
    pointer# = 9;
    let[mut] text: String << String::from("hello");
    text.push_str(", world");
    println("{} {}", count, text);
}
