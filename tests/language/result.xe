fn opened(file: File) {
    println("file size: {}", file.size());
}

fn failed(error: io::Error) {
    eprintln("open failed: {}", error@);
}

fn print_file_size(path: str) {
    // 无修饰 ? 必须显式处理正常和错误通道。
    File::open(path)?
        1> opened
        2> failed;
}

fn read_file(path: str) -> String?[io::Error] {
    // [return] 表示错误从当前函数提前返回。
    let file: File << File::open(path)?[return];
    file.read_to_string()
}

fn file_size_or_zero(path: str) -> usize {
    File::open(path)?
        1> file -> file.size()
        2> error -> {
            eprintln("{}", error@);
            0
        }
}

// 从仓库根运行时读取 README；审核在临时目录运行时验证失败恢复。
// 两种情况都能正常退出，文件/字符串的所有权在相应分支内回收。
fn main() {
    let path: str = "README.md";
    print_file_size(path);
    println("size or fallback: {}", file_size_or_zero(path));
    read_file(path)?
        1> text: String -> println("read {} bytes", text.len())
        2> failed;
}
