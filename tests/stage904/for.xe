fn main() {
    let values = [10, 20, 30, 40, 50];

    // 数组的默认迭代器产生共享只读借用。
    for value: i32@ in values {
        // 显式解引用。
        println("the value is: {}", value#);

        // Display 可以把格式化请求转发给所指对象。
        println("the value is: {}", value);

        // :p 只改变显示方式，不进行指针类型转换。
        println("the value address is: {:p}", value);
    }

    let[mut] mutable_values = [1, 2, 3];
    for value: i32@[mut] in mutable_values.iter_mut() {
        value# = value# * 2;
    }

    // 整数范围产生整数值，右端点不包含在范围内。
    for number in 1..4 {
        println("{}!", number);
    }
}
