fn main() {
    let first: String << gives_ownership();
    let second: String << String::from("hello");

    // second 按值传入，因此移动到函数参数中。
    let third: String << takes_and_gives_back(second);

    // 格式化也使用普通调用规则；显式借用才不会消耗 String。
    println("{} {}", first@, third@);
} // third 和 first 逆序析构；second 已经移出，不会再次析构。

fn gives_ownership() -> String {
    let value: String << String::from("yours");
    value
}

fn takes_and_gives_back(value: String) -> String {
    value
}
