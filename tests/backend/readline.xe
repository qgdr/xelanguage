// 外层 ? 表示读操作可能失败，内层 ? 表示成功时可能已经到达 EOF。
// 空行是一个拥有的空 String，和“没有下一行”不同。
fn main() -> i32 {
    while true {
        let reading: String??[io::Error] << std::io::readline();
        reading ?
            1> maybe_line -> {
                maybe_line ?
                    1> line -> {
                        print("line: ");
                        // 传入 String 的地址，让当前分支负责结束时的析构。
                        std::io::println("{}", line@);
                    }
                    2> _ -> {
                        // autoaudit 不提供输入，EOF 时立即正常退出，不等待交互。
                        println("eof");
                        return 0;
                    };
            }
            2> error -> {
                eprintln("read error: {}", error);
                return 1;
            };
    }
    0
}
